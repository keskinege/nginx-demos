                },
                {
                    "name": "claude-sonnet-4-6"
                }
            ]
        },
        "user-b": {
            "models": [
                {
                    "name": "gpt-5"
                }
            ]
        }
    },
    "models": {
        "gpt-5": {
            "provider": "openai",
            "location": "/openai"
        },
        "claude-sonnet-4-6": {
            "provider": "anthropic",
            "location": "/anthropic"
        }
    }
