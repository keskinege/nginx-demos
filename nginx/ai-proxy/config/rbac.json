{
    "semantic_cache": {
        "enabled": true,
        "similarity_threshold": 0.95,
        "text_similarity_threshold": 0.85,
        "ttl_seconds": 3600,
        "max_entries": 500,
        "embedding": {
            "provider": "ollama",
            "providers": {
                "ollama": {
                    "model": "nomic-embed-text",
